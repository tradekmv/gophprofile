# ===== Server =====
SERVER_ADDRESS=:8080
BASE_URL=http://localhost:8080
LOG_LEVEL=info
MAX_UPLOAD_SIZE=10485760
WEB_DIR=./web

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gophprofile
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_DSN=postgres://app:app@postgres:5432/gophprofile?sslmode=disable

# ===== S3 / MinIO =====
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=avatars
S3_ACCESS_KEY=gophprof
S3_SECRET_KEY=gophprof-secret-1
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/avatars

# ===== Kafka =====
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=avatar-events
KAFKA_CONSUMER_GROUP=gophprofile-worker
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ===== Thumbnail sizes =====
THUMBNAIL_SIZES=100x100,300x300
