# syntax=docker/dockerfile:1.6
# ---- build stage ----
FROM golang:1.25-alpine AS builder
WORKDIR /src

ENV CGO_ENABLED=0 GOOS=linux GOFLAGS=-trimpath

RUN apk add --no-cache git ca-certificates tzdata

ENV GOFLAGS=-mod=mod
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -ldflags="-s -w -buildid=" -o /out/worker ./cmd/worker

# ---- runtime stage ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata wget && \
    addgroup -S -g 65534 app && adduser -S -u 65534 -G app app

WORKDIR /app
COPY --from=builder --chown=app:app /out/worker /app/worker

# /tmp для readOnlyRootFilesystem=true.
RUN mkdir -p /tmp && chown app:app /tmp && chmod 1777 /tmp

USER 65534:65534
EXPOSE 9096

# Healthcheck: проверяет /healthz на metrics-порте.
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
    CMD wget -qO- http://localhost:9096/healthz || exit 1

ENTRYPOINT ["/app/worker"]
