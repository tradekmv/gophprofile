[
  {
    "orgId": 1,
    "name": "gophprofile-overview",
    "uid": "gophprofile-overview",
    "folder": "GophProfile",
    "type": "db",
    "title": "GophProfile — Overview",
    "tags": ["gophprofile", "overview"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "10s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {"type": "stat", "title": "HTTP RPS", "id": 1, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "sum(rate(avatars_http_requests_total[5m]))", "refId": "A"}], "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}},
      {"type": "stat", "title": "HTTP Error Rate (5xx)", "id": 2, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "sum(rate(avatars_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(avatars_http_requests_total[5m])), 1)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.1}]}}}},
      {"type": "stat", "title": "p95 HTTP Latency", "id": 3, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(avatars_http_request_duration_seconds_bucket[5m])) by (le))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 2}]}}}},
      {"type": "stat", "title": "Uploads Total (24h)", "id": 4, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "sum(increase(avatars_uploads_total[24h]))", "refId": "A"}]},
      {"type": "timeseries", "title": "HTTP Requests Rate by Status", "id": 10, "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "sum by (status) (rate(avatars_http_requests_total[1m]))", "refId": "A", "legendFormat": "{{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10}}}},
      {"type": "timeseries", "title": "HTTP Request Duration (p50, p95, p99)", "id": 11, "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "histogram_quantile(0.50, sum(rate(avatars_http_request_duration_seconds_bucket[1m])) by (le))", "refId": "A", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum(rate(avatars_http_request_duration_seconds_bucket[1m])) by (le))", "refId": "B", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.99, sum(rate(avatars_http_request_duration_seconds_bucket[1m])) by (le))", "refId": "C", "legendFormat": "p99"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5}}}},
      {"type": "timeseries", "title": "Upload Duration p95", "id": 12, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(avatars_upload_duration_seconds_bucket[1m])) by (le, status))", "refId": "A", "legendFormat": "p95 {{status}}"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5}}}},
      {"type": "timeseries", "title": "Upload Errors by Reason", "id": 13, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "sum by (reason) (rate(avatars_upload_errors_total[5m]))", "refId": "A", "legendFormat": "{{reason}}"}], "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "bars", "fillOpacity": 80}}}}
    ]
  },
