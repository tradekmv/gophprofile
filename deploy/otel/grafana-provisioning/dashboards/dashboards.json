      {"type": "timeseries", "title": "Processing Duration p50/p95/p99", "id": 11, "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "histogram_quantile(0.50, sum(rate(avatars_worker_processing_duration_seconds_bucket[1m])) by (le))", "refId": "A", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum(rate(avatars_worker_processing_duration_seconds_bucket[1m])) by (le))", "refId": "B", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.99, sum(rate(avatars_worker_processing_duration_seconds_bucket[1m])) by (le))", "refId": "C", "legendFormat": "p99"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5}}}},
      {"type": "timeseries", "title": "Failures by Reason", "id": 12, "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "targets": [{"expr": "sum by (reason) (rate(avatars_worker_failed_total[5m]))", "refId": "A", "legendFormat": "{{reason}}"}], "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "bars", "fillOpacity": 80}}}}
    ]
